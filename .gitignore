# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# chrome extension build output
/extension/dist/
# The packaged extension now lives under public/downloads/ (see
# extension/scripts/package.js) — intentionally NOT ignored, since Vercel
# serves whatever's committed under public/ as-is and there's no build-time
# packaging step wired into `next build`. Re-run `npm run package:extension`
# and commit the result whenever the extension changes.

.vercel
.env*
