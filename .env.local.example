# Copy to .env.local. Values below are Supabase's fixed local-dev demo
# keys (same for every `supabase start`) — safe to commit as an example,
# never real secrets. Get your project's real values from `supabase status`
# (local) or Project Settings → API (cloud).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Used
# only by /api/account for account deletion, which needs Supabase's admin
# API. Optional: without it, account deletion returns a clear 501 instead
# of working, everything else in the app still runs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
